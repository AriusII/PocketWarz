@page "/"
@rendermode InteractiveServer

<PageTitle>PocketWarz - Choose Your Pack!</PageTitle>

<div class="home-page">
    <!-- Hero Section -->
    <section class="hero-section" data-aos="fade-up">
        <div class="hero-particles"></div>
        <div class="container text-center">
            <span class="badge hero-badge mb-3">Season 1 Live</span>
            <h1 class="hero-title">
                <span class="title-icon">🐱</span>
                PocketWarz
                <span class="title-icon">🐕</span>
            </h1>
            <p class="hero-tagline">The ultimate battle between Cats and Dogs!</p>
            <p class="hero-subtitle">Choose your pack. Train your warriors. Conquer the arena!</p>
        </div>
    </section>

    <!-- Team Selection Section -->
    <section class="team-selection py-5" data-aos="fade-up">
        <div class="container">
            <h2 class="section-title text-center mb-5">
                <span class="sparkle">✨</span> Choose Your Pack <span class="sparkle">✨</span>
            </h2>

            <div class="row justify-content-center g-4">
                <!-- Cat Team -->
                <div class="col-lg-5 col-md-6">
                    <div class="team-card team-cats">
                        <div class="team-glow"></div>
                        <div class="team-content">
                            <div class="team-mascot">🐱</div>
                            <h3 class="team-name">The Cat Pack</h3>
                            <p class="team-motto">"Silent paws, deadly claws!"</p>
                            <ul class="team-traits">
                                <li><span class="trait-icon">⚡</span> Agility & Speed</li>
                                <li><span class="trait-icon">🎯</span> Precision Attacks</li>
                                <li><span class="trait-icon">🌙</span> Night Vision</li>
                                <li><span class="trait-icon">😼</span> Independent Spirit</li>
                            </ul>
                            <div class="team-members">
                                <span class="member">😺</span>
                                <span class="member">😸</span>
                                <span class="member">😻</span>
                                <span class="member">🙀</span>
                                <span class="member">😽</span>
                            </div>
                            <button class="btn btn-team btn-cats">
                                <span>🐾</span> Join the Cats!
                            </button>
                        </div>
                    </div>
                </div>

                <!-- VS Divider -->
                <div class="col-lg-2 d-flex align-items-center justify-content-center">
                    <div class="vs-badge">
                        <span class="vs-text">VS</span>
                        <div class="vs-lightning">⚔️</div>
                    </div>
                </div>

                <!-- Dog Team -->
                <div class="col-lg-5 col-md-6">
                    <div class="team-card team-dogs">
                        <div class="team-glow"></div>
                        <div class="team-content">
                            <div class="team-mascot">🐕</div>
                            <h3 class="team-name">The Dog Pack</h3>
                            <p class="team-motto">"Loyalty is our strength!"</p>
                            <ul class="team-traits">
                                <li><span class="trait-icon">💪</span> Strength & Power</li>
                                <li><span class="trait-icon">🛡️</span> Pack Defense</li>
                                <li><span class="trait-icon">👃</span> Enhanced Tracking</li>
                                <li><span class="trait-icon">🤝</span> Team Synergy</li>
                            </ul>
                            <div class="team-members">
                                <span class="member">🐶</span>
                                <span class="member">🐕</span>
                                <span class="member">🦮</span>
                                <span class="member">🐕‍🦺</span>
                                <span class="member">🐩</span>
                            </div>
                            <button class="btn btn-team btn-dogs">
                                <span>🐾</span> Join the Dogs!
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section py-5" data-aos="fade-up">
        <div class="container">
            <h2 class="section-title text-center mb-5">Why PocketWarz?</h2>

            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">⚔️</div>
                        <h4>Epic Battles</h4>
                        <p>Strategic turn-based combat with stunning Phaser3 animations</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">🎭</div>
                        <h4>Collect & Train</h4>
                        <p>Over 100+ unique pets to collect, train, and evolve</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">🏆</div>
                        <h4>Leaderboards</h4>
                        <p>Compete globally and climb the ranks to become champion</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">🎁</div>
                        <h4>Daily Rewards</h4>
                        <p>Log in daily for exclusive rewards and special events</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Decoration -->
    <div class="footer-decoration">
        <div class="paw-prints">
            <span>🐾</span><span>🐾</span><span>🐾</span><span>🐾</span><span>🐾</span>
        </div>
    </div>
</div>

